FROM node:16.19.0-buster-slim as server

RUN apt-get update \ 
    && apt-get upgrade -y \
    && apt-get install -y \
    git \
    make \
    g++ \
    python3

WORKDIR /home/node/cokodocs

COPY package.json .
COPY yarn.lock .

RUN chown -R node:node .
USER node

RUN yarn install  --production
COPY --chown=node:node . .

CMD ["node_modules/.bin/nodemon", "startServer.js", "--watch", "api", "--watch", "config", "--watch", "controllers", "--watch", "models", "--watch", "services", "--watch", "scripts", "--watch", "--ext", "js,graphql"]